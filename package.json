  "scripts": { "build": "tsc -p .", "test": "vitest run", "prepublishOnly": "npm run build && npm test" },
  "keywords": ["elizaos", "eliza", "plugin", "x402", "nano", "xno", "payments"],
  "license": "MIT",
  "dependencies": { "nanocurrency": "2.5.0" },
  "peerDependencies": { "@elizaos/core": "1.7.2" },
